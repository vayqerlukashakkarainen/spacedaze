{
	"name": "spacedaze",
	"type": "module",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"art:prepare": "swift scripts/prepareGeneratedSprite.swift",
		"art:simplify": "swift scripts/simplifySprite.swift",
		"art:ml": ".venv-art/bin/python scripts/mlPixelArt.py",
		"test:audio": "tsx src/audio/soundCatalog.test.ts",
		"test:visual-catalogs": "tsx src/visuals/visualCatalog.test.ts",
		"test:player-status": "tsx src/services/player/playerStatusEffectService.test.ts",
		"test:enemy-budgets": "tsx src/services/enemies/enemyEncounterBudgetService.test.ts && tsx src/services/enemies/enemyProgressionService.test.ts && tsx src/services/enemies/bossRegistry.test.ts",
		"typecheck": "node scripts/typecheckRuntimeBindings.mjs",
		"typecheck:full": "tsc --noEmit",
		"build": "npm run typecheck && vite build",
		"build:demo": "npm run typecheck && vite build --mode demo",
		"dev": "npm run typecheck && vite",
		"dev:demo": "npm run typecheck && vite --mode demo",
		"preview": "vite preview",
		"preview:demo": "vite preview --mode demo",
		"zip": "npm run build && mkdir -p dist && zip -r dist/game.zip dist -x \"**/.DS_Store\"",
		"test": "npm run typecheck && npm run test:sprites && npm run test:build-profile && npm run test:audio && npm run test:visual-catalogs && npm run test:enemy-budgets && npm run test:wake-enemies && npm run test:player-status && npm run test:profile-save && npm run test:reward-unlocks && npm run test:generation && npm run test:room-floors && npm run test:run-pool && npm run test:run-level && npm run test:wall-tiles && npm run test:pathfinding && npm run test:upgrade-requirements && npm run test:projectile-collision && npm run test:projectile-behaviors && npm run test:rocket-guidance && npm run test:stacking-rewards && npm run test:reward-quality && npm run test:ability-loadout && npm run test:weapon-service && npm run test:player-steering && npm run test:input-bindings && npm run test:ultimate-ability && npm run test:extra-life && npm run test:console-markdown && npm run test:threat && npm run test:chest-challenge && npm run test:hub-progress && npm run test:lasso-rig && npm run test:hub-settlement && npm run test:npc-dialogue && npm run test:shrine-level && npm run test:drone-roles && npm run test:performance-profiler && npm run test:run-loop && npm run test:frame-rate && npm run test:dense-pool && npm run test:spatial-hash && npm run test:quest && npm run test:debree-economy && npm run test:salvage-pickups && npm run test:telemetry",
		"test:build-profile": "tsx src/config/buildProfile.test.ts",
		"test:profile-save": "tsx src/services/progression/profileSaveService.test.ts && tsx src/services/narrative/narrativeService.test.ts",
		"test:reward-unlocks": "tsx src/services/progression/rewardUnlockProgressService.test.ts",
		"test:telemetry": "tsx src/services/runs/runTelemetryService.test.ts",
		"test:npc-dialogue": "tsx src/services/narrative/npcDialogueService.test.ts && tsx src/content/dialogue/dialogueCatalog.test.ts",
		"test:reward-quality": "tsx src/services/economy/rewardQualityService.test.ts",
		"test:ability-loadout": "tsx src/services/abilities/abilityLoadoutService.test.ts && tsx src/services/abilities/activeModuleService.test.ts && tsx src/services/abilities/droneFrenzyService.test.ts",
		"test:weapon-service": "tsx src/services/player/weaponService.test.ts",
		"test:rocket-guidance": "tsx src/services/combat/rocketGuidanceService.test.ts",
		"test:player-steering": "tsx src/services/input/playerSteeringModeService.test.ts",
		"test:input-bindings": "tsx src/services/input/inputBindingService.test.ts",
		"test:ultimate-ability": "tsx src/services/abilities/ultimateAbilityService.test.ts",
		"test:extra-life": "tsx src/services/progression/extraLifeService.test.ts",
		"test:sprites": "swift scripts/normalizeSpritePngs.swift public/sprites --check",
		"sprites:normalize": "swift scripts/normalizeSpritePngs.swift public/sprites --write",
		"test:generation": "tsx src/generation/test/generation.test.ts",
		"test:room-floors": "tsx src/stamps/combat/combatSpawnerProfileCatalog.test.ts && tsx src/generation/test/roomFloorGenerator.test.ts && tsx src/generation/test/roomTemplateBuilder.test.ts && tsx src/levels/roomGroundPlatforms.test.ts && tsx src/services/world/roomFloorService.test.ts && tsx src/services/runs/runUpgradeShopService.test.ts",
		"test:wake-enemies": "tsx src/services/enemies/wakeMiniBossService.test.ts && tsx src/services/enemies/wakeEncounterService.test.ts",
		"test:run-pool": "tsx src/services/runs/runLevelPool.test.ts",
		"test:run-level": "tsx src/services/runs/runLevelService.test.ts",
		"test:wall-tiles": "tsx src/levels/hexWallTiles.test.ts",
		"test:upgrade-requirements": "tsx src/services/progression/upgradeRequirementService.test.ts",
		"test:projectile-collision": "tsx src/services/combat/projectileCollisionService.test.ts",
		"test:projectile-behaviors": "tsx src/upgrades/projectileBehaviorsNew.test.ts",
		"test:stacking-rewards": "tsx src/upgrades/stackingRewardsNew.test.ts",
		"test:console-markdown": "tsx src/ui/consoleMarkdown.test.ts",
		"test:threat": "tsx src/services/enemies/threatService.test.ts",
		"test:chest-challenge": "tsx src/ui/chestChallenge.test.ts && tsx src/ui/chestOpeningMode.test.ts",
		"test:hub-progress": "tsx src/services/hub/hubProgressService.test.ts && tsx src/services/hub/pilotProtocolService.test.ts && tsx src/services/hub/expeditionSupportService.test.ts",
		"test:lasso-rig": "tsx src/services/hub/lassoRigService.test.ts",
		"test:hub-settlement": "tsx src/stamps/hub/hubPuzzleStampCatalog.test.ts && tsx src/stamps/hub/restorationFloorStamp.test.ts && tsx src/spawn/spawnHubSettlement.test.ts",
		"test:shrine-level": "tsx src/spawn/shrine/shrineLevel.test.ts",
		"test:drone-roles": "tsx src/services/player/droneRoleService.test.ts && tsx src/services/economy/salvagerCargoService.test.ts",
		"test:performance-profiler": "tsx src/services/debug/frameProfilerService.test.ts",
		"test:run-loop": "tsx src/services/runs/runLoopService.test.ts",
		"test:frame-rate": "tsx src/services/core/frameRateService.test.ts && tsx src/services/core/cadencedSystemService.test.ts",
		"test:dense-pool": "tsx src/services/core/densePool.test.ts",
		"test:spatial-hash": "tsx src/services/core/spatialHash.test.ts",
		"test:pathfinding": "tsx --test src/grid/hexPathfinding.test.ts",
		"test:quest": "tsx src/services/progression/questService.test.ts",
		"test:debree-economy": "tsx src/services/economy/debreeEconomyService.test.ts && tsx src/services/economy/phaseCoreService.test.ts && tsx src/services/economy/psionicPlateService.test.ts && tsx src/services/economy/thrusterPartService.test.ts",
		"test:salvage-pickups": "tsx src/services/economy/salvagePickupService.test.ts",
		"test:generator": "tsx src/generation/test/testGenerator.ts"
	},
	"dependencies": {
		"kaplay": "4000.0.0-alpha.27.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.19",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^6.3.5"
	}
}
